# ================================
# Nichie Bot — Environment Config
# ================================

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (dari https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model
GEMINI_MODEL=gemini-3.6-flash

# Database path (relatif dari root project)
DATABASE_PATH=data/ginchiee.db

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Google Calendar OAuth2 (Opsional — Per-User Integration)
# Cara setup:
# 1. Buka https://console.cloud.google.com
# 2. Buat project → Enable "Google Calendar API"
# 3. APIs & Services → Credentials → + Create Credentials → OAuth 2.0 Client ID
# 4. Application type: Desktop app
# 5. Download JSON → simpan sebagai config/oauth_client_secrets.json
# 6. Isi path file di bawah ini:
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=config/oauth_client_secrets.json

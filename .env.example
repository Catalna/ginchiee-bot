# ================================
# Ginchiee Bot — Environment Config
# ================================

# Telegram Bot Token (dari @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key (dari https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model
GEMINI_MODEL=gemini-flash-lite-latest

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Connection string, BUKAN path file.
# Local (kalau install Postgres sendiri):
#   DATABASE_URL=postgresql://ginchiee:ginchiee@localhost:5432/ginchiee
# Managed gratis (Neon / Supabase / Render):
#   DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
#
# Di Hugging Face, set ini sebagai "Variable and secrets" > Secrets.
DATABASE_URL=postgresql://user:password@host:5432/ginchiee?sslmode=require

# ── Persona / AI tuning ───────────────────────────────────────────────────────
# Makin tinggi = makin ekspresif & variatif (0.0-2.0)
AI_TEMPERATURE=0.95
AI_TOP_P=0.95
# Batas panjang balasan — memaksa Ginchiee tetap singkat ala chat
AI_MAX_OUTPUT_TOKENS=220

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ── Keamanan (opsional) ───────────────────────────────────────────────────────
# Daftar Telegram user_id yang boleh pakai bot, dipisah koma.
# Kosongkan untuk mengizinkan semua orang.
# Contoh: ALLOWED_USER_IDS=123456789,987654321
ALLOWED_USER_IDS=
